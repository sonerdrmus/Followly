generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  passwordHash    String         @map("password_hash")
  displayName     String         @map("display_name")
  avatarUrl       String?        @map("avatar_url")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  refreshTokens        RefreshToken[]
  instagramAccount     InstagramAccount?
  instagramOAuthStates InstagramOAuthState[]

  @@index([isActive])
  @@map("users")
}

enum InstagramConnectionStatus {
  connected
  disconnected
  expired
  revoked

  @@map("instagram_connection_status")
}

enum InstagramAuthMethod {
  instagram_login
  unified_login

  @@map("instagram_auth_method")
}

model InstagramAccount {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @unique @map("user_id") @db.Uuid
  instagramUserId      String                     @map("instagram_user_id")
  username             String
  displayName          String?                    @map("display_name")
  profilePictureUrl    String?                    @map("profile_picture_url")
  accountType          String?                    @map("account_type")
  followersCount       Int?                       @map("followers_count")
  followsCount         Int?                       @map("follows_count")
  mediaCount           Int?                       @map("media_count")
  accessTokenEncrypted String?                    @map("access_token_encrypted")
  tokenExpiresAt       DateTime?                  @map("token_expires_at")
  tokenIssuedAt        DateTime?                  @map("token_issued_at")
  scopes               String
  authMethod           InstagramAuthMethod        @default(instagram_login) @map("auth_method")
  clientBusinessId     String?                    @map("client_business_id")
  connectionStatus     InstagramConnectionStatus  @map("connection_status")
  lastSyncedAt         DateTime?                  @map("last_synced_at")
  connectedAt          DateTime                   @map("connected_at")
  disconnectedAt       DateTime?                  @map("disconnected_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instagramUserId])
  @@map("instagram_accounts")
}

model InstagramOAuthState {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  stateHash String    @unique @map("state_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("instagram_oauth_states")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
