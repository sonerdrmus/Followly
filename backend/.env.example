# Copy to backend/.env. Do not commit backend/.env.
# These values are server-only. Never copy them into EXPO_PUBLIC_ variables.

NODE_ENV=development
PORT=3000

# Must match the Docker Compose credentials. The host API uses localhost,
# because Compose publishes PostgreSQL and Redis onto the machine.
DATABASE_URL=postgresql://followly:followly_dev_only@localhost:5432/followly?schema=public
REDIS_URL=redis://localhost:6379/0

# At least 32 characters. Generate a unique value for every environment.
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated browser origins. Native apps usually send no Origin header.
# In development, any http://localhost or http://127.0.0.1 port is also allowed,
# because Expo picks the next free port when 8081 is already in use.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8084,http://localhost:19006

# Global rate limit, then tighter limits for /auth and /instagram routes. TTL is seconds.
THROTTLE_TTL=60
THROTTLE_LIMIT=60
AUTH_THROTTLE_LIMIT=8
INSTAGRAM_THROTTLE_LIMIT=30

# Instagram connection. Leave the app id, secret, and config id empty until
# they exist in the Meta App Dashboard. Never put the secret in the Expo app.
# A config id selects Instagram API with Unified Login and requires an https
# redirect. Leave it empty to keep Instagram API with Instagram Login.
# Generate a 32-byte key that is different from JWT_ACCESS_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_CONFIG_ID=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/instagram/callback
META_INSTAGRAM_API_VERSION=v27.0
META_INSTAGRAM_SCOPES=instagram_business_basic
META_TOKEN_ENCRYPTION_KEY=replace-with-a-different-32-byte-base64-key
META_TOKEN_ENCRYPTION_KEY_PREVIOUS=
