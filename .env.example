# Copy this file to .env at the repository root.
# Expo inlines only variables prefixed with EXPO_PUBLIC_ into the mobile app.
# Database credentials, JWT secrets, and Redis URLs belong in backend/.env.
# Never prefix those secrets with EXPO_PUBLIC_.

# Mobile API base URL, including the /api/v1 prefix.
# A simulator on this computer can use localhost.
# A physical phone cannot: localhost is the phone. Use the computer's LAN address,
# for example http://192.168.0.234:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Docker Compose reads these. They are not mobile variables.
# followly_dev_only is a local default. Replace it outside this machine.
POSTGRES_USER=followly
POSTGRES_PASSWORD=followly_dev_only
POSTGRES_DB=followly
POSTGRES_PORT=5432
REDIS_PORT=6379
